# ── LLM Provider Switch ──────────────────────────────
# Options: ollama | anthropic | gemini
LLM_PROVIDER=ollama

# ── Ollama (local, no cost, data never leaves server) ─
OLLAMA_MODEL=deepseek-r1:1.5b

# ── Anthropic (cloud) ─────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Gemini (cloud) ────────────────────────────────────
GEMINI_API_KEY=AIza...
