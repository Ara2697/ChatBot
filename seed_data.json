  "kb_docs": [
    {
      "doc_id": "KB-001",
      "title": "California THC Product Restrictions",
      "visibility": "internal",
      "text": "California (CA) prohibits the sale of Delta-9 THC edibles, THC beverages, and Delta-8 products through unlicensed B2B channels. Only state-licensed dispensaries may carry THC products. All CBD products require a valid COA and lab report. Violations may result in license revocation and fines up to $10,000 per incident."
    },
    {
      "doc_id": "KB-002",
      "title": "Vendor Onboarding Requirements",
      "visibility": "internal",
      "text": "All vendors must submit: (1) valid business license, (2) certificate of analysis (COA) for lab-tested products, (3) lab report for THC/CBD/Delta-8 categories, (4) MSDS for vape hardware products. Products in the THC Beverage category additionally require FDA registration. Missing net weight or volume fields will result in automatic REVIEW status pending correction."
    },
    {
      "doc_id": "KB-003",
      "title": "Age Restriction Policy",
      "visibility": "portal_customer",
      "text": "All nicotine, THC, Delta-8, and hemp flower products are restricted to buyers aged 21 and above. Retailers must implement age verification at point of sale. GW Products reserves the right to suspend accounts found selling age-restricted products to minors. PACT Act compliance is mandatory for all nicotine shipments."
    },
    {
      "doc_id": "KB-004",
      "title": "State-by-State Compliance Summary",
      "visibility": "internal",
      "text": "Idaho (ID): Bans all THC, Delta-8, CBD, and hemp products. Texas (TX): Bans Delta-9 THC edibles and beverages; allows hemp-derived CBD under 0.3% THC. California (CA): Bans Delta-9 THC and Delta-8 outside licensed dispensaries; allows CBD with valid COA. Florida (FL): Bans THC beverages; allows nicotine and CBD products. South Dakota (SD) and Nebraska (NE): Ban CBD products. Always verify current state law before fulfilling orders."
    },
    {
      "doc_id": "KB-005",
      "title": "Hot Picks Ranking Methodology",
      "visibility": "internal",
      "text": "Hot picks are ranked by popularity_score, a composite metric updated weekly based on units sold, reorder rate, and customer ratings. Products with a score above 80 are considered high-velocity items. Compliance filtering is always applied after ranking — blocked products are never surfaced to customers regardless of score."
    },
    {
      "doc_id": "KB-006",
      "title": "Lab Report and COA Policy",
      "visibility": "portal_vendor",
      "text": "Lab reports must be issued by an ISO/IEC 17025 accredited laboratory. Reports must be dated within 12 months of submission. The COA must include cannabinoid profile, heavy metals, pesticides, and residual solvents panels. Products submitted without a valid lab report will be placed in REVIEW status and cannot be listed until documentation is complete."
    }
  ]
